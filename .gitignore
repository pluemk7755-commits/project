# PRIVATE-REPOSITORY EDITION — never change visibility to Public while real data is stored.
# Never publish email sender credentials or app password.
/data/smtp.env
.env
.env.*
**/smtp.env
# Unnecessary local files
__pycache__/
*.py[cod]
.venv/
venv/
*.log
.pytest_cache/
*_backup*
*.bak

**/.env
**/.env.*
*.pem
*.key
credentials.json
service_account.json
# Customer payment slips uploaded during runtime
/data/uploads/*
!/data/uploads/.gitkeep

# Local database backups
/data/backups/

# SQLite temporary files
/data/*.sqlite3-wal
/data/*.sqlite3-shm
